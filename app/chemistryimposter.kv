#:import MDBoxLayout kivymd.uix.boxlayout.MDBoxLayout
#:import MDLabel kivymd.uix.label.MDLabel
#:import MDButton kivymd.uix.button.MDButton
#:import MDButtonText kivymd.uix.button.MDButtonText
#:import MDTextField kivymd.uix.textfield.MDTextField
#:import MDTextFieldHintText kivymd.uix.textfield.MDTextFieldHintText

<Interface>:
    orientation: 'vertical'
    padding: dp(24)
    spacing: dp(40)
    md_bg_color: .05, .05, .1, 1

    Widget:
        size_hint_y: .3

    MDLabel:
        text: 'Химический шпион'
        halign: 'center'
        theme_font_size: 'Custom'
        font_size: dp(40)
        size_hint_y: None
        height: dp(60)
        color: 0, 0, 1, 1

    MDTextField:
        id: members_count_field
        mode: 'outlined'
        input_filter: 'int'
        size_hint_x: .9
        pos_hint: {'center_x': .5}
        size_hint_y: None
        height: dp(56)
        theme_text_color: 'Custom'
        text_color_normal: 0, 0, 1, 1
        text_color_focus: 0, 0, 1, 1

        MDTextFieldHintText:
            text: 'Введите количество участников'

    MDButton:
        id: start_button
        theme_bg_color: 'Custom'
        size_hint_x: .9
        size_hint_y: None
        height: dp(100)
        pos_hint: {'center_x': .5}
        md_bg_color: .05, .05, .2, 1

        MDButtonText:
            id: start_button_text
            text: 'Нажмите чтобы начать игру'
            font_size: '20sp'
            color: 0, 0, 1, 1

    Widget:
        size_hint_y: .3
